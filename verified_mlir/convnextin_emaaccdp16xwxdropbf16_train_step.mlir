    %v19 = stablehlo.multiply %v18, %v18 : tensor<64x3136x96xf32>
    %v20 = stablehlo.reduce(%v19 init: %v12) applies stablehlo.add across dimensions = [2] : (tensor<64x3136x96xf32>, tensor<f32>) -> tensor<64x3136xf32>
    %v21 = stablehlo.broadcast_in_dim %v20, dims = [0, 1] : (tensor<64x3136xf32>) -> tensor<64x3136x96xf32>
